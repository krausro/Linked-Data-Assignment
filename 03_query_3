# Query for number of publications per organisational unit within a certain year

PREFIX dcterms: <http://purl.org/dc/terms/> 
PREFIX obo: <http://purl.obolibrary.org/obo/>

SELECT (COUNT(DISTINCT?publication) as ?count) ?ounit
WHERE
{
	?publication dcterms:issued "2025" .
	?publication dcterms:creator ?creator .
	?creator obo:BFO_0000050 ?ounit .
}
GROUP BY ?ounit
